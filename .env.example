# Copy to .env and adjust. Never commit the real .env file.

# --- Paths (relative paths are resolved from the project root)
SIEM_LOG_FILE=logs/security.log
SIEM_DB_PATH=database/siem.db

# --- Backend API
SIEM_API_HOST=127.0.0.1
SIEM_API_PORT=8000
SIEM_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Seconds between automatic log-processing runs (0 = only on demand)
SIEM_PROCESS_INTERVAL=5

# --- Dashboard (Streamlit) -> where to find the API
SIEM_API_URL=http://127.0.0.1:8000

# --- Detection context
SIEM_MALICIOUS_IPS=185.44.12.10,45.12.88.21,91.22.15.44,203.0.113.66,203.0.113.99
SIEM_FAILED_WINDOW_SECONDS=600

# --- Demo login app (practice target that generates real log events)
DEMO_APP_HOST=127.0.0.1
DEMO_APP_PORT=5000
DEMO_USERNAME=admin
DEMO_PASSWORD=change-me-demo-only
DEMO_ALLOW_SIMULATED_IP=false
DEMO_DEBUG=false
